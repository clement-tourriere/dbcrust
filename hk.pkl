amends "package://github.com/jdx/hk/releases/download/v1.39.0/hk@1.39.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.39.0/hk@1.39.0#/Builtins.pkl"

// third_party/ holds vendored upstream crates (see third_party/tiberius/DBCRUST_PATCH.md):
// they keep their own formatting and lint level, so no step touches them.
local vendored = "third_party/**"

local linters = new Mapping<String, Step> {
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = vendored }
    ["newlines"] = (Builtins.newlines) { exclude = vendored }
    ["check-merge-conflict"] = (Builtins.check_merge_conflict) { exclude = vendored }
    ["cargo-fmt"] {
        glob = "**/*.rs"
        exclude = List("python/**", vendored)
        check = "rustfmt --check"
        fix = "rustfmt"
    }
    ["cargo-clippy"] {
        glob = "**/*.rs"
        exclude = List("python/**", "tests/**", vendored)
        // Same flags as CI (ci.yml); structural allows live in Cargo.toml [workspace.lints.clippy]
        check = "cargo clippy --all-targets -- -D warnings"
    }
    ["ruff"] {
        glob = "python/**/*.py"
        // Same rule selection as CI (ci.yml "ruff (errors only)")
        check = "ruff check python/dbcrust --select E9,F821,F811"
        fix = "ruff check python/dbcrust --select E9,F821,F811 --fix"
    }
    ["ty"] {
        glob = "python/**/*.py"
        check = "ty check python/dbcrust"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ...linters
        }
    }
    ["commit-msg"] {
        steps {
            ["check-conventional-commit"] = Builtins.check_conventional_commit
        }
    }
    ["check"] {
        steps {
            ...linters
        }
    }
    ["fix"] {
        fix = true
        steps {
            ...linters
        }
    }
}
